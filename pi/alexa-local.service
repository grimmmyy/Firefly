[Unit]
Description=spotcast local Alexa control (Hue bridge emulation)
After=network-online.target spotcast.service
Wants=network-online.target

[Service]
ExecStart=/usr/bin/python3 /opt/spotcast/alexa_local.py
EnvironmentFile=-/etc/spotcast/alexa.env
Restart=always
RestartSec=5
DynamicUser=yes
AmbientCapabilities=CAP_NET_BIND_SERVICE
StateDirectory=spotcast-alexa

[Install]
WantedBy=multi-user.target
