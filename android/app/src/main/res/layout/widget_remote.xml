<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="8dp"
    android:background="@drawable/widget_bg">
    <TextView
        android:id="@+id/w_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Living Room"
        android:textColor="#FFFFFFFF"
        android:textSize="14sp"
        android:gravity="center"
        android:paddingBottom="4dp"/>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <Button android:id="@+id/w_power" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:text="Power" android:textSize="12sp"/>
        <Button android:id="@+id/w_down" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:text="Vol −" android:textSize="12sp"/>
        <Button android:id="@+id/w_up" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:text="Vol +" android:textSize="12sp"/>
        <Button android:id="@+id/w_night" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:text="Night" android:textSize="12sp"/>
    </LinearLayout>
</LinearLayout>
